{
  "name": "octopus-kit",
  "version": "0.6.0",
  "description": "Shared themes, server helpers, app manifest and scaffold for the octopus app suite",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "tokens",
    "ui",
    "server",
    "manifest",
    "brand",
    "bin",
    "blocks",
    "templates",
    "docs"
  ],
  "scripts": {
    "test": "node --test",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "build:channel": "node scripts/build-channel.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "bin": {
    "create-octopus-app": "bin/create-octopus-app.mjs",
    "octopus-favicon-pack": "bin/octopus-favicon-pack.mjs",
    "octopus-check-overflow": "bin/octopus-check-overflow.mjs",
    "octopus-check-layout": "bin/octopus-check-layout.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1"
  }
}
